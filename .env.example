# ILMU — Malaysia's sovereign LLM (YTL AI Labs). https://console.ilmu.ai
ILMU_API_KEY=sk-your-key-here
ILMU_MODEL=nemo-super

# Optional fallback. Both providers are OpenAI-compatible, so this is a
# one-line swap in lib/ai.ts if ILMU early-access is down.
OPENROUTER_API_KEY=

# Optional — enables live ratings/hours in Paddock Mamak. Without it, static
# curated info is used instead; nothing breaks.
GOOGLE_MAPS_API_KEY=
