# ILMU — Malaysia's sovereign LLM (YTL AI Labs). https://console.ilmu.ai
ILMU_API_KEY=sk-your-key-here
ILMU_MODEL=nemo-super

# Optional fallback. Both providers are OpenAI-compatible, so this is a
# one-line swap in lib/ai.ts if ILMU early-access is down.
OPENROUTER_API_KEY=

# Optional — enables live ratings/hours in Paddock Mamak. Server-side only,
# never exposed to the browser. Without it, static curated info is used.
GOOGLE_MAPS_API_KEY=

# Optional — enables the embedded route map. This one IS exposed to the
# browser (it is an iframe src), so restrict it by HTTP referrer in the Google
# Cloud console and enable only "Maps Embed API" on it. Without it the map is
# simply hidden and the Maps links still work.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
